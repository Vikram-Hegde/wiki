---
import { Font } from "astro:assets";
import { execSync } from "node:child_process";
import "../global.css";

const GITHUB_USER = "Vikram-Hegde";
const NOW_REPO_COUNT = 4;
const ACTIVE_THRESHOLD_DAYS = 90;

type Repo = {
    name: string;
    html_url: string;
    description: string | null;
    language: string | null;
    archived: boolean;
    fork: boolean;
    stargazers_count: number;
    pushed_at: string;
    created_at: string;
};

type LanguageStat = {
    name: string;
    count: number;
    activeCount: number;
    stars: number;
    earliest: string;
    latest: string;
    mostRecent: string;
};

type NowLog = { repos: Repo[]; error: string | null };
type Stack = { languages: LanguageStat[]; totalRepos: number; error: string | null };

let now: NowLog = { repos: [], error: null };
let stack: Stack = { languages: [], totalRepos: 0, error: null };

try {
    const res = await fetch(
        `https://api.github.com/users/${GITHUB_USER}/repos?sort=pushed&per_page=100&type=owner`,
        {
            headers: { Accept: "application/vnd.github+json" },
            signal: AbortSignal.timeout(5000),
        },
    );
    if (!res.ok) throw new Error(`GitHub API returned ${res.status}`);
    const data: Repo[] = await res.json();
    const own = data
        .filter((r) => r.name.toLowerCase() !== GITHUB_USER.toLowerCase())
        .filter((r) => !r.fork);

    now.repos = own.slice(0, NOW_REPO_COUNT);

    // Aggregate by language for STACK.MD
    const langMap = new Map<string, LanguageStat>();
    for (const r of own) {
        if (!r.language) continue;
        const lang = r.language;
        const existing = langMap.get(lang) ?? {
            name: lang,
            count: 0,
            activeCount: 0,
            stars: 0,
            earliest: r.created_at,
            latest: r.pushed_at,
            mostRecent: r.pushed_at,
        };
        const days = (Date.now() - new Date(r.pushed_at).getTime()) / (1000 * 60 * 60 * 24);
        existing.count += 1;
        existing.stars += r.stargazers_count;
        if (days <= ACTIVE_THRESHOLD_DAYS) existing.activeCount += 1;
        if (new Date(r.created_at) < new Date(existing.earliest)) existing.earliest = r.created_at;
        if (new Date(r.pushed_at) > new Date(existing.latest)) existing.latest = r.pushed_at;
        if (new Date(r.pushed_at) > new Date(existing.mostRecent)) existing.mostRecent = r.pushed_at;
        langMap.set(lang, existing);
    }
    stack.languages = Array.from(langMap.values())
        .sort((a, b) => new Date(b.mostRecent).getTime() - new Date(a.mostRecent).getTime());
    stack.totalRepos = own.length;
} catch (e) {
    const msg = e instanceof Error ? e.message : String(e);
    now.error = msg;
    stack.error = msg;
}

const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

// Build-time metrics (real, derived from the actual build environment)
const BUILD_NOW = new Date();
const BUILD_DATE_ISO = BUILD_NOW.toISOString().slice(0, 10); // YYYY-MM-DD
const BUILD_DATE_HUMAN = `${BUILD_NOW.getUTCFullYear()}-${String(BUILD_NOW.getUTCMonth() + 1).padStart(2, "0")}-${String(BUILD_NOW.getUTCDate()).padStart(2, "0")}`;
const BUILD_YEAR = BUILD_NOW.getUTCFullYear();
const BUILD_TIME_HUMAN = `${String(BUILD_NOW.getUTCHours()).padStart(2, "0")}:${String(BUILD_NOW.getUTCMinutes()).padStart(2, "0")} UTC`;

let gitHash: string;
let gitDirty: boolean;
try {
    gitHash = execSync("git rev-parse --short HEAD", { encoding: "utf-8" }).trim();
    gitDirty = execSync("git diff --quiet HEAD; echo $?", { encoding: "utf-8" }).trim() !== "0";
} catch {
    gitHash = "no-git";
    gitDirty = false;
}

// Flip to true when the blog is real. Until then, the § WRITING.LOG section
// is hidden but the code is preserved in source.
const SHOW_WRITING = false;

const SECTION_COUNT = SHOW_WRITING ? 9 : 8; // hero-label, hero, focus, bio, now, stack, [writing,] contact, eof

function monthYear(iso: string): string {
    const d = new Date(iso);
    return `→ ${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
}

function yearOnly(iso: string): string {
    return String(new Date(iso).getUTCFullYear());
}

function relativeMonth(iso: string): string {
    const d = new Date(iso);
    const months = (Date.now() - d.getTime()) / (1000 * 60 * 60 * 24 * 30);
    return months < 1 ? "THIS MONTH" : `${Math.floor(months)} MO AGO`;
}

function deriveStatus(repo: Repo): string {
    if (repo.archived) return "ARCHIVED";
    const days = (Date.now() - new Date(repo.pushed_at).getTime()) / (1000 * 60 * 60 * 24);
    if (days < 30) return "SHIPPING";
    if (days < 180) return "MAINTAIN";
    if (days < 365) return "STALE";
    return "DORMANT";
}

function pluralize(n: number, singular: string, plural: string): string {
    return `${n} ${n === 1 ? singular : plural}`;
}
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Personal site of Vikram, a frontend engineer building clean and intrinsic experiences for the modern web"
        />
        <meta name="author" content="Vikram" />
        <link rel="canonical" href="https://vikram.wiki/" />
        <meta http-equiv="content-language" content="en" />
        <Font cssVariable="--font-jetbrains-mono" preload />
        <title>Vikram | Design Technologist</title>
    </head>
    <body>
        <div class="page">
            <nav class="nav">
                <a href="/" class="nav__logo">VIKRAM/</a>
                <ul class="nav__links">
                    <li><a href="#work" class="nav__link">[01] Work</a></li>
                    <li><a href="#writing" class="nav__link">[02] Writing</a></li>
                    <li><a href="#about" class="nav__link">[03] About</a></li>
                    <li><a href="#contact" class="nav__link nav__link--active">[04] Contact →</a></li>
                </ul>
            </nav>

            <main>
                <section class="hero-label">
                    <div>// HERO / 001</div>
                    <div class="hero-label__dim">EST. 2018 / BANGALORE, IN / UTC+5:30</div>
                </section>

                <section class="hero" aria-label="Introduction">
                    <h1 class="hero__title">
                        Frontend<br/>engineer.<br/>Small details.<br/>Big opinions.
                    </h1>
                </section>

                <section class="focus" aria-label="Current focus">
                    <div class="focus__left">
                        <span>// FOCUS</span>
                        <span class="focus__dim">intrinsic web design, container queries, type systems</span>
                    </div>
                    <div class="focus__right">
                        <span class="focus__dim">UPDATED {BUILD_DATE_HUMAN}</span>
                        <span class="focus__chip">{gitHash}{gitDirty ? "*" : ""}</span>
                    </div>
                </section>

                <section class="bio" id="about" aria-labelledby="bio-label">
                    <div class="bio__label">
                        <div id="bio-label">BIO</div>
                        <div class="bio__sub">→ 002</div>
                    </div>
                    <div class="bio__body">
                        <p>
                            Vikram Hegde. Frontend engineer based in Bangalore. Writes
                            React, fights with CSS, ships small libraries, and redesigns
                            this site on a quarterly basis.
                        </p>
                        <p class="bio__muted">
                            Currently obsessed with intrinsic web design, container
                            queries, and the small interactions that make a product feel
                            considered. TypeScript by day, plain HTML by preference.
                        </p>
                    </div>
                </section>

                <section class="now" id="work" aria-labelledby="now-label">
                    <header class="section-header">
                        <h2 id="now-label">§ NOW.LOG</h2>
                        <div class="section-header__meta">
                            {now.error
                                ? `OFFLINE / GITHUB API UNAVAILABLE`
                                : (() => {
                                    const activeCount = now.repos.filter((r) => deriveStatus(r) === "SHIPPING").length;
                                    const lastPush = now.repos[0]?.pushed_at;
                                    const lastPushHuman = lastPush
                                        ? relativeMonth(lastPush).toLowerCase()
                                        : "never";
                                    return `${activeCount} SHIPPING / LAST PUSH ${lastPushHuman} / PULLED FROM github.com/${GITHUB_USER}`;
                                })()}
                        </div>
                    </header>

                    <div class="now__table">
                        {now.error ? (
                            <div class="now__row">
                                <div class="now__cell now__cell--status">
                                    <div class="now__cell-label">STATUS</div>
                                    <div class="now__cell-value">OFFLINE</div>
                                </div>
                                <div class="now__cell now__cell--project">
                                    <div class="now__cell-label">SOURCE</div>
                                    <div class="now__project-name">github.com/{GITHUB_USER}</div>
                                    <div class="now__project-meta">fetch failed at build time</div>
                                </div>
                                <div class="now__cell now__cell--what">
                                    <div class="now__cell-label">WHAT</div>
                                    <div class="now__cell-body">{now.error}. The build fell back to offline data; the page still works.</div>
                                </div>
                                <div class="now__cell now__cell--since">
                                    <div class="now__cell-label now__cell-label--right">NEXT</div>
                                    <div class="now__cell-value now__cell-value--right">↻ RETRY BUILD</div>
                                </div>
                            </div>
                        ) : (
                            now.repos.map((repo, i) => (
                                <div class:list={["now__row", { "now__row--active": i === 0 }]}>
                                    <div class="now__cell now__cell--status">
                                        <div class:list={["now__cell-label", { "now__cell-label--dim": i !== 0 }]}>STATUS</div>
                                        <div class="now__cell-value">{deriveStatus(repo)}</div>
                                    </div>
                                    <div class="now__cell now__cell--project">
                                        <div class="now__cell-label">REPO</div>
                                        <div>
                                            <a
                                                href={repo.html_url}
                                                class="now__project-name now__project-name--link"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                            >
                                                {repo.name}
                                            </a>
                                            <div class="now__project-meta">
                                                {repo.language ? `${repo.language} / ` : ""}★ {repo.stargazers_count}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="now__cell now__cell--what">
                                        <div class="now__cell-label">WHAT</div>
                                        <div class="now__cell-body">{repo.description || "(no description)"}</div>
                                    </div>
                                    <div class="now__cell now__cell--since">
                                        <div class="now__cell-label now__cell-label--right">PUSHED</div>
                                        <div class="now__cell-value now__cell-value--right">
                                            {monthYear(repo.pushed_at)} / {relativeMonth(repo.pushed_at)}
                                        </div>
                                    </div>
                                </div>
                            ))
                        )}
                    </div>

                    {!now.error && (
                        <div class="now__footer">
                            <a
                                href={`https://github.com/${GITHUB_USER}?tab=repositories&sort=updated`}
                                class="now__footer-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                ↗ ALL REPOS ON github.com/{GITHUB_USER}
                            </a>
                        </div>
                    )}
                </section>

                <section class="stack" aria-labelledby="stack-label">
                    <header class="section-header">
                        <h2 id="stack-label">§ STACK.MD</h2>
                        <div class="section-header__meta">
                            {stack.error
                                ? `OFFLINE / FALLBACK`
                                : `${stack.languages.length} LANGUAGES / ${stack.totalRepos} PUBLIC REPOS / PULLED FROM GITHUB`}
                        </div>
                    </header>

                    <div class="stack__table">
                        {stack.error ? (
                            <div class="stack__row">
                                <div class="stack__num">--</div>
                                <div class="stack__name">UNKNOWN</div>
                                <div class="stack__desc">Could not derive a stack — {stack.error}</div>
                                <div class="stack__year">↻ RETRY BUILD</div>
                            </div>
                        ) : (
                            stack.languages.map((lang, i) => (
                                <div class="stack__row">
                                    <div class="stack__num">{String(i + 1).padStart(2, "0")}</div>
                                    <div class="stack__name">{lang.name}</div>
                                    <div class="stack__desc">
                                        {pluralize(lang.count, "repo", "repos")}
                                        {" / "}
                                        <span class:list={["stack__desc-active", { "stack__desc-active--live": lang.activeCount > 0 }]}>
                                            {pluralize(lang.activeCount, "active", "active")}
                                        </span>
                                        {lang.stars > 0 && (
                                            <>
                                                {" / "}★ {lang.stars}
                                            </>
                                        )}
                                    </div>
                                </div>
                            ))
                        )}
                    </div>
                </section>

                {SHOW_WRITING && (
                <section class="writing" id="writing" aria-labelledby="writing-label">
                    <header class="section-header">
                        <h2 id="writing-label">§ WRITING.LOG</h2>
                        <div class="section-header__meta">3 ENTRIES / 2 PUBLISHED / 1 DRAFT</div>
                    </header>

                    <div class="writing__list">
                        <a href="#" class="writing__row">
                            <div class="writing__date">2026-02-14</div>
                            <div class="writing__badge writing__badge--published">PUBLISHED</div>
                            <div class="writing__title">On Container Queries, Finally</div>
                            <div class="writing__meta">essay / 9 min read</div>
                            <div class="writing__arrow">↗</div>
                        </a>
                        <a href="#" class="writing__row">
                            <div class="writing__date">2025-11-03</div>
                            <div class="writing__badge writing__badge--published">PUBLISHED</div>
                            <div class="writing__title">A Defense of Plain HTML</div>
                            <div class="writing__meta">essay / 6 min read</div>
                            <div class="writing__arrow">↗</div>
                        </a>
                        <a href="#" class="writing__row">
                            <div class="writing__date">2025-08-21</div>
                            <div class="writing__badge writing__badge--draft">DRAFT</div>
                            <div class="writing__title">Notes on a Smaller Web</div>
                            <div class="writing__meta">notes / 1,200 words</div>
                            <div class="writing__arrow">↗</div>
                        </a>
                    </div>
                </section>
                )}

                <section class="contact" id="contact" aria-labelledby="contact-label">
                    <header class="section-header">
                        <h2 id="contact-label">§ CONTACT.LINKS</h2>
                        <div class="section-header__meta">3 CHANNELS / ALWAYS REPLY</div>
                    </header>

                    <div class="contact__grid">
                        <a href="https://x.com/_vikramhegde_" class="contact__card" target="_blank" rel="noopener noreferrer">
                            <div class="contact__card-header">
                                <span>[01]</span>
                                <span>↗</span>
                            </div>
                            <div>
                                <div class="contact__card-name">X / TWITTER</div>
                                <div class="contact__card-handle">@_vikramhegde_</div>
                            </div>
                        </a>
                        <a href={`https://github.com/${GITHUB_USER}`} class="contact__card" target="_blank" rel="noopener noreferrer">
                            <div class="contact__card-header">
                                <span>[02]</span>
                                <span>↗</span>
                            </div>
                            <div>
                                <div class="contact__card-name">GITHUB</div>
                                <div class="contact__card-handle">vikram-hegde</div>
                            </div>
                        </a>
                        <a href="https://www.linkedin.com/in/vikramcodes" class="contact__card" target="_blank" rel="noopener noreferrer">
                            <div class="contact__card-header">
                                <span>[03]</span>
                                <span>↗</span>
                            </div>
                            <div>
                                <div class="contact__card-name">LINKEDIN</div>
                                <div class="contact__card-handle">vikramcodes</div>
                            </div>
                        </a>
                    </div>
                </section>

                <section class="eof" aria-hidden="true">
                    <pre class="eof__pre">{`// ════════════════════════════════════════════════════════════════════
//  EOF — index.html rendered. ${SECTION_COUNT} sections. 0 dependencies.
//  Built: ${BUILD_DATE_HUMAN} ${BUILD_TIME_HUMAN}  ·  Commit: ${gitHash}${gitDirty ? " (dirty)" : ""}
//  "Make it work, make it right, make it small."  — k.n.
// ════════════════════════════════════════════════════════════════════`}</pre>
                </section>
            </main>

            <footer class="footer">
                <div class="footer__left">
                    <span>© {BUILD_YEAR} VIKRAM HEGDE</span>
                    <span class="footer__dim">BUILT WITH ASTRO</span>
                    <span class="footer__dim">NO JS FRAMEWORKS WERE HARMED</span>
                </div>
                <div class="footer__right">
                    <span class="footer__dim">EOF</span>
                    <span class="footer__chip">{gitHash}{gitDirty ? "*" : ""}</span>
                </div>
            </footer>
        </div>

        <script is:inline type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Vikram",
                "url": "https://vikram.wiki",
                "jobTitle": "Design Technologist",
                "sameAs": [
                    `https://github.com/${GITHUB_USER}`,
                    "https://www.linkedin.com/in/vikramcodes"
                ]
            }
        </script>
    </body>
</html>

<style>
    .page {
        max-width: 1440px;
        margin-inline: auto;
        background-color: var(--bg);
        color: var(--fg);
    }

    /* ───────────────────────────────────────────────────────────────
       NAV
       ─────────────────────────────────────────────────────────────── */
    .nav {
        padding: 24px var(--wrapper-padding);
        border-bottom: 2px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .nav__logo {
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 0.95;
    }

    .nav__links {
        display: flex;
    }

    .nav__link {
        padding: 10px 16px;
        border: 1px solid var(--border);
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        transition: background-color 0.1s, color 0.1s;
    }

    .nav__link + .nav__link,
    .nav__links li + li .nav__link {
        border-left: none;
    }

    .nav__link:hover {
        background-color: var(--fg);
        color: var(--bg);
    }

    .nav__link--active,
    .nav__link--active:hover {
        background-color: var(--inverse-bg);
        color: var(--inverse-fg);
    }

    /* ───────────────────────────────────────────────────────────────
       HERO LABEL + HEADLINE
       ─────────────────────────────────────────────────────────────── */
    .hero-label {
        padding: 48px var(--wrapper-padding) 32px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid var(--border);
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 600;
    }

    .hero-label__dim {
        color: var(--fg-muted);
        font-weight: 500;
    }

    .hero {
        padding: 0 var(--wrapper-padding) 40px;
    }

    .hero__title {
        font-size: clamp(48px, 9vw, 104px);
        line-height: 0.95;
        letter-spacing: -0.05em;
        font-weight: 800;
        text-transform: uppercase;
        margin: 0;
    }

    /* ───────────────────────────────────────────────────────────────
       FOCUS BAR
       ─────────────────────────────────────────────────────────────── */
    .focus {
        border-top: 2px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px var(--wrapper-padding);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .focus__left,
    .focus__right {
        display: flex;
        gap: 24px;
        align-items: center;
    }

    .focus__dim {
        opacity: 0.6;
    }

    .focus__chip {
        background-color: var(--inverse-bg);
        color: var(--inverse-fg);
        padding: 2px 8px;
    }

    /* ───────────────────────────────────────────────────────────────
       BIO
       ─────────────────────────────────────────────────────────────── */
    .bio {
        border-bottom: 2px solid var(--border);
        display: flex;
        align-items: stretch;
    }

    .bio__label {
        width: 200px;
        flex-shrink: 0;
        padding: 24px;
        border-right: 2px solid var(--border);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .bio__sub {
        opacity: 0.5;
        font-size: 11px;
        font-weight: 400;
    }

    .bio__body {
        flex: 1;
        padding: 24px var(--wrapper-padding);
        display: flex;
        gap: 40px;
        font-size: 15px;
        line-height: 1.55;
    }

    .bio__body p {
        flex: 1;
    }

    .bio__muted {
        opacity: 0.65;
        font-weight: 400;
    }

    /* ───────────────────────────────────────────────────────────────
       SECTION HEADERS
       ─────────────────────────────────────────────────────────────── */
    .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        padding: 48px var(--wrapper-padding) 16px;
    }

    .section-header h2 {
        font-size: clamp(22px, 2.5vw, 32px);
        font-weight: 800;
        letter-spacing: -0.02em;
        text-transform: uppercase;
    }

    .section-header__meta {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    /* ───────────────────────────────────────────────────────────────
       § NOW.LOG
       ─────────────────────────────────────────────────────────────── */
    .now__table {
        border-top: 2px solid var(--border);
    }

    .now__row {
        display: flex;
        align-items: stretch;
        border-bottom: 1px solid var(--border);
        min-height: 140px;
    }

    .now__row:last-child {
        border-bottom: none;
    }

    .now__cell {
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .now__cell--status {
        width: 140px;
        flex-shrink: 0;
        border-right: 1px solid var(--border);
    }

    .now__row--active .now__cell--status {
        background-color: var(--inverse-bg);
        color: var(--inverse-fg);
    }

    .now__cell--project {
        width: 300px;
        flex-shrink: 0;
        border-right: 1px solid var(--border);
    }

    .now__cell--what {
        flex: 1;
        border-right: 1px solid var(--border);
    }

    .now__cell--since {
        width: 140px;
        flex-shrink: 0;
        align-items: flex-end;
    }

    .now__cell-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        opacity: 0.6;
    }

    .now__cell-label--right {
        text-align: right;
    }

    .now__cell-label--dim {
        opacity: 0.5;
    }

    .now__cell-value {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    .now__cell-value--right {
