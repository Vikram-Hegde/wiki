---
import "../global.css";

import { fetchGitHubData } from "../lib/github";
import Layout from "../layouts/Layout.astro";

import Nav from "../components/Nav.astro";
import HeroLabel from "../components/HeroLabel.astro";
import Hero from "../components/Hero.astro";
import FocusBar from "../components/FocusBar.astro";
import Bio from "../components/Bio.astro";
import NowLog from "../components/NowLog.astro";
import Stack from "../components/Stack.astro";
import Writing from "../components/Writing.astro";
import Contact from "../components/Contact.astro";
import Eof from "../components/Eof.astro";
import Footer from "../components/Footer.astro";

const GITHUB_USER = "Vikram-Hegde";

const SHOW_WRITING = false;

const { now, stack } = await fetchGitHubData();
---

<Layout>
    <Nav slot="bleed" />

    <main>
        <HeroLabel />
        <Hero />
        <FocusBar />
        <Bio />
        <NowLog now={now} />
        <Stack stack={stack} />

        {SHOW_WRITING && <Writing />}

        <Contact />
        <Eof />
    </main>

    <Footer slot="bleed-end" />

    <script is:inline type="application/ld+json" slot="head">
        {
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Vikram",
            "url": "https://vikram.wiki",
            "jobTitle": "Design Technologist",
            "sameAs": [
                `https://github.com/${GITHUB_USER}`,
                "https://www.linkedin.com/in/vikramcodes"
            ]
        }
    </script>
</Layout>
