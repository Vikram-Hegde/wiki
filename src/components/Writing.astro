---
import SectionHeader from "./SectionHeader.astro";
---
<section class="writing" id="writing" aria-labelledby="writing-label">
    <SectionHeader
        id="writing-label"
        title="WRITING.LOG"
        meta="3 ENTRIES / 2 PUBLISHED / 1 DRAFT"
    />

    <div class="writing__list">
        <a href="#" class="writing__row">
            <div class="writing__date">2026-02-14</div>
            <div class="writing__badge writing__badge--published">PUBLISHED</div>
            <div class="writing__title">On Container Queries, Finally</div>
            <div class="writing__meta">essay / 9 min read</div>
            <div class="writing__arrow">↗</div>
        </a>
        <a href="#" class="writing__row">
            <div class="writing__date">2025-11-03</div>
            <div class="writing__badge writing__badge--published">PUBLISHED</div>
            <div class="writing__title">A Defense of Plain HTML</div>
            <div class="writing__meta">essay / 6 min read</div>
            <div class="writing__arrow">↗</div>
        </a>
        <a href="#" class="writing__row">
            <div class="writing__date">2025-08-21</div>
            <div class="writing__badge writing__badge--draft">DRAFT</div>
            <div class="writing__title">Notes on a Smaller Web</div>
            <div class="writing__meta">notes / 1,200 words</div>
            <div class="writing__arrow">↗</div>
        </a>
    </div>
</section>

<style>
    .writing__list {
        border-top: 2px solid var(--border);
    }

    .writing__row {
        display: flex;
        align-items: center;
        padding: 24px 0;
        border-bottom: 1px solid var(--border);
        transition: background-color 0.1s;
        color: var(--fg);
        text-decoration: none;
    }

    .writing__row:last-child {
        border-bottom: none;
    }

    .writing__row:hover {
        background-color: var(--border-subtle);
    }

    .writing__date {
        width: 120px;
        flex-shrink: 0;
        padding: 0 16px;
        font-size: 13px;
        font-weight: 600;
        opacity: 0.6;
    }

    .writing__badge {
        width: 110px;
        flex-shrink: 0;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        margin: 0 16px;
        border: 1px solid var(--border);
    }

    .writing__badge--published {
        background-color: var(--inverse-bg);
        color: var(--inverse-fg);
        border-color: var(--inverse-bg);
    }

    .writing__badge--draft {
        background-color: transparent;
        color: var(--fg);
    }

    .writing__title {
        flex: 1;
        padding: 0 24px;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .writing__meta {
        width: 200px;
        flex-shrink: 0;
        padding: 0 16px;
        font-size: 12px;
        font-weight: 500;
        opacity: 0.6;
    }

    .writing__arrow {
        width: 60px;
        flex-shrink: 0;
        padding: 0 16px;
        font-size: 20px;
        font-weight: 600;
        text-align: right;
    }

    @media (max-width: 640px) {
        .writing__row {
            flex-wrap: wrap;
            padding: 16px 0;
        }
        .writing__date {
            width: auto;
            padding: 0 16px;
        }
        .writing__badge {
            margin: 0 16px 0 0;
        }
        .writing__title {
            width: 100%;
            padding: 12px 16px 0;
            order: 5;
        }
        .writing__meta {
            width: auto;
            padding: 0 16px;
        }
        .writing__arrow {
            width: auto;
            padding: 0 16px;
        }
    }
</style>
