---
const { id, title, meta } = Astro.props as {
    id?: string;
    title: string;
    meta: string;
};
---
<header class="section-header">
    <h2 id={id}>{title}</h2>
    <div class="section-header__meta">{meta}</div>
</header>

<style>
    .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        padding: 48px var(--wrapper-padding) 16px;
    }

    .section-header h2 {
        font-size: clamp(22px, 2.5vw, 32px);
        font-weight: 800;
        letter-spacing: -0.02em;
        text-transform: uppercase;
    }

    .section-header__meta {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
    }

    @media (max-width: 520px) {
        .section-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
        }
    }
</style>
