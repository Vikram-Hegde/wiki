---
---
<section class="hero-label">
    <div class="hero-label__inner">
        <div>// HERO / 001</div>
        <div class="hero-label__dim">EST. 2018 / BANGALORE, IN / UTC+5:30</div>
    </div>
</section>

<style>
    .hero-label {
        padding: 48px var(--wrapper-padding) 32px;
        border-bottom: 1px solid var(--border);
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-weight: 600;
        container-type: inline-size;
    }

    .hero-label__inner {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .hero-label__dim {
        color: var(--fg-muted);
        font-weight: 500;
    }

    @container (max-width: 720px) {
        .hero-label__inner {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }
        .hero-label {
            font-size: 11px;
        }
    }
</style>
