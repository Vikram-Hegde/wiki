---
import { BUILD_YEAR, gitHash, gitDirty } from "../lib/build";
---
<footer class="footer">
    <div class="footer__inner">
        <div class="footer__left">
            <span>© {BUILD_YEAR} VIKRAM HEGDE</span>
            <span class="footer__dim">BUILT WITH ASTRO</span>
            <span class="footer__dim">NO JS FRAMEWORKS WERE HARMED</span>
        </div>
        <div class="footer__right">
            <span class="footer__dim">EOF</span>
            <span class="footer__chip">{gitHash}{gitDirty ? "*" : ""}</span>
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: var(--inverse-bg);
        color: var(--inverse-fg);
        padding: 20px var(--wrapper-padding);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        container-type: inline-size;
    }

    .footer__inner {
        max-width: 1440px;
        margin-inline: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .footer__left,
    .footer__right {
        display: flex;
        column-gap: 24px;
        row-gap: 16px;
        align-items: center;
        flex-wrap: wrap;
    }

    .footer__dim {
        opacity: 0.6;
    }

    .footer__chip {
        background-color: var(--inverse-fg);
        color: var(--inverse-bg);
        padding: 2px 8px;
        font-weight: 700;
    }

    @container (max-width: 520px) {
        .footer__inner {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }
    }
</style>
